{
  "sub": "\n                <div class=\"detail-fault-sheet-dialog\">\n                    <div class=\"detail-fault-sheet-title\">机构重启 · TEST001</div>\n                    <button type=\"button\" class=\"detail-fault-sheet-option\" onclick=\"window.CofeFaultRestartFlow.dispatch('重启系统')\">重启系统</button><button type=\"button\" class=\"detail-fault-sheet-option\" onclick=\"window.CofeFaultRestartFlow.dispatch('重启点单屏（左）')\">重启点单屏（左）</button><button type=\"button\" class=\"detail-fault-sheet-option\" onclick=\"window.CofeFaultRestartFlow.dispatch('重启点单屏（右）')\">重启点单屏（右）</button><button type=\"button\" class=\"detail-fault-sheet-option\" onclick=\"window.CofeFaultRestartFlow.dispatch('重启六轴机械臂（注意安全，谨慎使用）')\">重启六轴机械臂（注意安全，谨慎使用）</button>\n                </div>\n            ",
  "confirm_system": "\n                    <div class=\"detail-fault-sheet-dialog\">\n                        <div class=\"detail-fault-sheet-title\">确认操作</div>\n                        <div class=\"detail-remote-restart-confirm-shell\">\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-primary\" onclick=\"window.CofeFaultRestartFlow.dispatch('确认软件重启')\">\n                                <span>确认软件重启</span>\n                                <span class=\"detail-remote-restart-confirm-arrow\">›</span>\n                            </button>\n                            <div class=\"detail-remote-restart-confirm-callout\">确定要重启系统？</div>\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-helper\" onclick=\"window.CofeFaultRestartFlow.dispatch('无法远程处理？查看机器按钮位置')\">\n                                <span>无法远程处理？查看机器按钮位置</span>\n                                <span class=\"detail-remote-restart-confirm-arrow\">›</span>\n                            </button>\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-cancel\" onclick=\"window.CofeFaultRestartFlow.dispatch('取消')\">取消</button>\n                        </div>\n                    </div>\n                ",
  "confirm_left": "\n                    <div class=\"detail-fault-sheet-dialog\">\n                        <div class=\"detail-fault-sheet-title\">确认操作</div>\n                        <div class=\"detail-remote-restart-confirm-shell\">\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-primary\" onclick=\"window.CofeFaultRestartFlow.dispatch('确认软件重启')\">\n                                <span>确认软件重启</span>\n                                <span class=\"detail-remote-restart-confirm-arrow\">›</span>\n                            </button>\n                            <div class=\"detail-remote-restart-confirm-callout\">确定要重启点单屏（左）？</div>\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-helper\" onclick=\"window.CofeFaultRestartFlow.dispatch('无法远程处理？查看机器按钮位置')\">\n                                <span>无法远程处理？查看机器按钮位置</span>\n                                <span class=\"detail-remote-restart-confirm-arrow\">›</span>\n                            </button>\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-cancel\" onclick=\"window.CofeFaultRestartFlow.dispatch('取消')\">取消</button>\n                        </div>\n                    </div>\n                ",
  "confirm_right": "\n                    <div class=\"detail-fault-sheet-dialog\">\n                        <div class=\"detail-fault-sheet-title\">确认操作</div>\n                        <div class=\"detail-remote-restart-confirm-shell\">\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-primary\" onclick=\"window.CofeFaultRestartFlow.dispatch('确认软件重启')\">\n                                <span>确认软件重启</span>\n                                <span class=\"detail-remote-restart-confirm-arrow\">›</span>\n                            </button>\n                            <div class=\"detail-remote-restart-confirm-callout\">确定要重启点单屏（右）？</div>\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-helper\" onclick=\"window.CofeFaultRestartFlow.dispatch('无法远程处理？查看机器按钮位置')\">\n                                <span>无法远程处理？查看机器按钮位置</span>\n                                <span class=\"detail-remote-restart-confirm-arrow\">›</span>\n                            </button>\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-cancel\" onclick=\"window.CofeFaultRestartFlow.dispatch('取消')\">取消</button>\n                        </div>\n                    </div>\n                ",
  "confirm_arm": "\n                    <div class=\"detail-fault-sheet-dialog\">\n                        <div class=\"detail-fault-sheet-title\">确认操作</div>\n                        <div class=\"detail-remote-restart-confirm-shell\">\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-primary\" onclick=\"window.CofeFaultRestartFlow.dispatch('确认软件重启')\">\n                                <span>确认软件重启</span>\n                                <span class=\"detail-remote-restart-confirm-arrow\">›</span>\n                            </button>\n                            <div class=\"detail-remote-restart-confirm-callout\">确定要重启六轴机械臂（注意安全，谨慎使用）？</div>\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-helper\" onclick=\"window.CofeFaultRestartFlow.dispatch('无法远程处理？查看机器按钮位置')\">\n                                <span>无法远程处理？查看机器按钮位置</span>\n                                <span class=\"detail-remote-restart-confirm-arrow\">›</span>\n                            </button>\n                            <button type=\"button\" class=\"detail-remote-restart-confirm-cancel\" onclick=\"window.CofeFaultRestartFlow.dispatch('取消')\">取消</button>\n                        </div>\n                    </div>\n                ",
  "guide_system": "\n                <div class=\"detail-fault-sheet-dialog\">\n                    <div class=\"detail-fault-sheet-title\">机器按钮位置 · 重启系统 · TEST001</div>\n                    <div class=\"detail-remote-restart-guide-shell\">\n                        <div class=\"detail-remote-restart-guide-card\">\n                            <div class=\"detail-remote-restart-guide-warning\">该操作需要客户在设备现场完成，系统无法远程执行。</div>\n                            <div class=\"detail-remote-restart-guide-image\" role=\"img\" aria-label=\"整机重启按钮位置示意图\">\n                                <div class=\"detail-remote-restart-guide-image-label\">整机重启按钮位置示意图</div>\n                                <div class=\"detail-remote-restart-guide-image-diagram\">请客户查看设备机身侧面或背部控制区域，寻找整机电源 / 重启按钮。</div>\n                            </div>\n                            <ol class=\"detail-remote-restart-guide-steps\"><li>请先确认设备周边无人操作，避免重启过程中误触。</li><li>在设备机身侧面或背部找到整机电源 / 重启按钮。</li><li>按住按钮约 3 秒后松开，等待系统重新启动。</li><li>等待设备恢复后，再返回页面查看设备状态。</li></ol>\n                        </div>\n                        <button type=\"button\" class=\"detail-remote-restart-guide-action\" onclick=\"window.CofeFaultRestartFlow.dispatch('我知道了')\">我知道了</button>\n                    </div>\n                </div>\n            ",
  "guide_left": "\n                <div class=\"detail-fault-sheet-dialog\">\n                    <div class=\"detail-fault-sheet-title\">机器按钮位置 · 重启点单屏（左） · TEST001</div>\n                    <div class=\"detail-remote-restart-guide-shell\">\n                        <div class=\"detail-remote-restart-guide-card\">\n                            <div class=\"detail-remote-restart-guide-warning\">该操作需要客户在设备现场完成，系统无法远程执行。</div>\n                            <div class=\"detail-remote-restart-guide-image\" role=\"img\" aria-label=\"左侧点单屏按钮位置示意图\">\n                                <div class=\"detail-remote-restart-guide-image-label\">左侧点单屏按钮位置示意图</div>\n                                <div class=\"detail-remote-restart-guide-image-diagram\">请客户查看左侧点单屏边框背面或屏幕下缘，找到该屏对应的电源按钮。</div>\n                            </div>\n                            <ol class=\"detail-remote-restart-guide-steps\"><li>确认左侧点单屏当前无人操作后，再进行重启。</li><li>在左侧点单屏边框背面或下沿找到电源按钮。</li><li>短按关闭后等待 2 秒，再次按下启动左侧点单屏。</li><li>屏幕重新点亮后，确认页面恢复正常显示。</li></ol>\n                        </div>\n                        <button type=\"button\" class=\"detail-remote-restart-guide-action\" onclick=\"window.CofeFaultRestartFlow.dispatch('我知道了')\">我知道了</button>\n                    </div>\n                </div>\n            ",
  "guide_right": "\n                <div class=\"detail-fault-sheet-dialog\">\n                    <div class=\"detail-fault-sheet-title\">机器按钮位置 · 重启点单屏（右） · TEST001</div>\n                    <div class=\"detail-remote-restart-guide-shell\">\n                        <div class=\"detail-remote-restart-guide-card\">\n                            <div class=\"detail-remote-restart-guide-warning\">该操作需要客户在设备现场完成，系统无法远程执行。</div>\n                            <div class=\"detail-remote-restart-guide-image\" role=\"img\" aria-label=\"右侧点单屏按钮位置示意图\">\n                                <div class=\"detail-remote-restart-guide-image-label\">右侧点单屏按钮位置示意图</div>\n                                <div class=\"detail-remote-restart-guide-image-diagram\">请客户查看右侧点单屏边框背面或屏幕下缘，找到该屏对应的电源按钮。</div>\n                            </div>\n                            <ol class=\"detail-remote-restart-guide-steps\"><li>确认右侧点单屏当前无人操作后，再进行重启。</li><li>在右侧点单屏边框背面或下沿找到电源按钮。</li><li>短按关闭后等待 2 秒，再次按下启动右侧点单屏。</li><li>屏幕重新点亮后，确认页面恢复正常显示。</li></ol>\n                        </div>\n                        <button type=\"button\" class=\"detail-remote-restart-guide-action\" onclick=\"window.CofeFaultRestartFlow.dispatch('我知道了')\">我知道了</button>\n                    </div>\n                </div>\n            ",
  "guide_arm": "\n                <div class=\"detail-fault-sheet-dialog\">\n                    <div class=\"detail-fault-sheet-title\">机器按钮位置 · 重启六轴机械臂 · TEST001</div>\n                    <div class=\"detail-remote-restart-guide-shell\">\n                        <div class=\"detail-remote-restart-guide-card\">\n                            <div class=\"detail-remote-restart-guide-warning\">该操作需要客户在设备现场完成，系统无法远程执行。请先确认机械臂周边安全后再操作。</div>\n                            <div class=\"detail-remote-restart-guide-image\" role=\"img\" aria-label=\"六轴机械臂控制按钮位置示意图\">\n                                <div class=\"detail-remote-restart-guide-image-label\">六轴机械臂控制按钮位置示意图</div>\n                                <div class=\"detail-remote-restart-guide-image-diagram\">请客户在确保机械臂周边安全的前提下，查看控制柜或机械臂基座上的控制按钮区域。</div>\n                            </div>\n                            <ol class=\"detail-remote-restart-guide-steps\"><li>先确认机械臂作业范围内无人、无障碍物，再进行操作。</li><li>在控制柜或机械臂基座找到机械臂控制电源按钮。</li><li>按流程关闭机械臂电源，等待数秒后再次启动。</li><li>机械臂重新上电后，再观察其是否恢复待机状态。</li></ol>\n                        </div>\n                        <button type=\"button\" class=\"detail-remote-restart-guide-action\" onclick=\"window.CofeFaultRestartFlow.dispatch('我知道了')\">我知道了</button>\n                    </div>\n                </div>\n            "
}
